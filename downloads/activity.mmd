    Login --> Dashboard : Success
    Dashboard --> InitiateTransfer
    InitiateTransfer --> CheckBalance
    
    state CheckBalance {
        [*] --> HasSufficientFunds
        HasSufficientFunds --> DeductBalance : Yes
        HasSufficientFunds --> RejectTransfer : No
    }
    
    DeductBalance --> ProcessTransaction
    ProcessTransaction --> NotifyRecipient
    NotifyRecipient --> [*]
